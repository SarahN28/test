void TriBulle(int tab[], int n){
  bool desordre;
  int i, k;
  int* t;
  k = n-1;
  do {
    desordre = false;
    for (i=0; i<k; i++){
      if (tab[i]>tab[i+1]){
        desordre = true;
        t = tab[i];
        tab[i]=tab[i+1];
        tab[i+1]=t;
      }
    }
    k = k-1;
  } while (k>0 && desordre);
}
